---
import { wellingtonPrompts } from "../../data/wellington-prompts";

interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<figure class:list={["hr", { "hr--compact": compact }]} aria-label="Examples of enterprise agent policies and questions">
 <div class="hr-pane">{wellingtonPrompts.map(prompt => <div class="hr-prompt"><span>{prompt}</span></div>)}</div>
 <span class="hr-stem" aria-hidden="true"></span><div class="hr-logo"><img src="/wellington/mark.svg" alt="Wellington" width="48" height="48"/></div>
</figure>
<style>
.hr{box-sizing:border-box;width:calc(100% - 80px);max-width:1880px;margin:64px auto 0;padding:48px 8% 38px;border-radius:24px;overflow:hidden;background:linear-gradient(#06132333,#06132333),url('https://cdn.sanity.io/images/rjtqmwfu/web3-prod/6021d912573f103a4c14aa4125d87b6926b75a44-2880x1200.png?auto=format&w=2400') center/cover #061323;display:flex;flex-direction:column;align-items:center;color:#f4f6ef;font-family:Arial,Helvetica,sans-serif;isolation:isolate}
.hr-pane{box-sizing:border-box;width:100%;padding:30px 34px;display:flex;flex-direction:column;gap:14px;border:1px solid #c9d6ed4d;border-radius:16px;background:linear-gradient(135deg,#e1e9ff22,#d4d9ff0b),#06132366;box-shadow:inset 0 1px 0 #ffffff1a;backdrop-filter:blur(18px)}
.hr-prompt{box-sizing:border-box;display:flex;align-items:center;gap:14px;width:fit-content;max-width:100%;padding:13px 22px;border:1px solid #d5dff48c;background:#e1e9ff18;border-radius:999px;font-size:clamp(16px,1.4vw,25px);line-height:1.35;box-shadow:inset 0 1px 0 #ffffff18}.hr-prompt svg{width:22px;height:22px;flex-shrink:0;fill:none;stroke:currentColor;stroke-width:1.8}.hr-stem{width:1px;height:30px;background:linear-gradient(#c9d6ed80,#c9d6ed)}.hr-logo{display:grid;place-items:center;width:70px;height:70px;box-sizing:border-box;border:6px solid #9ba9c3;border-radius:14px;background:#f7f8f2;box-shadow:0 0 0 1px #c9d6ed47}.hr-logo img{width:45px;height:45px}
@media(min-width:1600px){.hr{padding-top:64px;padding-bottom:48px}.hr-pane{padding:40px 44px;gap:20px}.hr-prompt{padding:16px 26px}.hr-stem{height:38px}.hr-logo{width:84px;height:84px}}
@media(max-width:1000px){.hr{width:calc(100% - 48px);padding:36px 5% 30px}.hr-pane{padding:24px;gap:12px}.hr-prompt{font-size:16px;padding:12px 16px}}
@media(max-width:700px){.hr{width:calc(100% - 40px);margin-top:36px;padding:24px 18px 26px;border-radius:16px}.hr-pane{padding:20px 14px;border-radius:12px}.hr-prompt{width:100%;font-size:14px;padding:11px 13px;gap:9px;border-radius:20px}.hr-prompt:nth-child(n){margin-left:0;max-width:100%;align-self:stretch}.hr-prompt svg{width:18px;height:18px}.hr-logo{width:60px;height:60px}.hr-logo img{width:38px;height:38px}.hr-stem{height:24px}}
/* Reserve space for the offset on both sides of each centered bubble. */
.hr .hr-pane{--stagger:clamp(10px,5vw,76px);align-items:center}
.hr .hr-prompt{align-self:center;width:fit-content;max-width:calc(100% - 2 * var(--stagger));transform:translateX(calc(-1 * var(--stagger)))}
.hr .hr-prompt:nth-child(even){transform:translateX(var(--stagger))}
@media(max-width:700px){.hr .hr-pane{--stagger:8px}}
.hr.hr--compact{width:100%;max-width:none;margin:0;padding:32px 48px;border-radius:var(--r,20px)}
@media(max-width:700px){.hr.hr--compact{padding:24px 18px 26px;border-radius:16px}}
</style>
