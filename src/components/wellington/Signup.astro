---
import { WELLINGTON } from "../../config";
const { id = "wellington-signup", compass = false } = Astro.props;
---

<section class:list={["ws-signup", {"ws-signup--compass":compass}]} id={id} aria-labelledby={`${id}-heading`}>
  <div class="wrap ws-layout">
    <div class="ws-message">
      <h2 id={`${id}-heading`}>
        {compass ? <>Which agent workflow would you put into production?</> : <>Get Wellington<br/>access updates.</>}
      </h2>
      <p>{compass ? "Tell us what it needs to do and what your team would need to verify before letting it run. Get updates as Wellington develops." : "Get occasional updates on the alpha and when you can try Wellington."}</p>
      {compass && <ul class="ws-benefits"><li><strong>Control access.</strong> Define which resources each agent can use.</li><li><strong>Set rules for action.</strong> Decide what agents can do and what needs approval.</li><li><strong>Review decisions.</strong> See what happened and why.</li></ul>}
    </div>
    <div class="ws-card">
      <form
        id={`${id}-form`}
        tabindex="-1"
        name="wellington-signup"
        method="POST"
        action="/wellington/signup-thanks/"
        data-netlify="true"
        netlify-honeypot="bot-field"
        data-wellington-signup
      >
        <input type="hidden" name="form-name" value="wellington-signup" />
        <p class="ws-honeypot" aria-hidden="true">
          <label>
            Leave this empty
            <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>
        {compass && <>
          <div class="ws-name-row">
            <label for={`${id}-first-name`}>First name<input required id={`${id}-first-name`} name="first-name" autocomplete="given-name" maxlength="80" placeholder="First name"/></label>
            <label for={`${id}-last-name`}>Last name<input required id={`${id}-last-name`} name="last-name" autocomplete="family-name" maxlength="80" placeholder="Last name"/></label>
          </div>
          <label for={`${id}-company`}>Company<input required id={`${id}-company`} name="company" autocomplete="organization" maxlength="120" placeholder="Company"/></label>
        </>}
        <label for={`${id}-email`}>
          Email
          <input
            id={`${id}-email`}
            type="email"
            placeholder="you@example.com"
            name="email"
            autocomplete="email"
            maxlength="254"
            required
          />
        </label>
        {compass && <>
          <label for={`${id}-country`}>Country or region<input required id={`${id}-country`} name="country-region" autocomplete="country-name" maxlength="100" placeholder="Country or region"/></label>
          <label for={`${id}-use-case`}>Which agent workflow would you like to govern?<textarea required id={`${id}-use-case`} name="use-case" rows="3" maxlength="2000" placeholder="Describe the workflow you’d like to govern."/></label>
        </>}
        <p class="ws-privacy">
          See the{" "}
          <a href="https://innovatingfuture.com/privacy/" target="_blank" rel="noopener noreferrer">
            CIF privacy policy
          </a>
          .
        </p>
        <button type="submit">
          {WELLINGTON.accessLabel}
          <svg
            aria-hidden="true"
            width="18"
            height="18"
            viewBox="0 0 20 20"
            fill="none"
          >
            <path
              d="M3 10h14m-5-5 5 5-5 5"
              stroke="currentColor"
              stroke-width="1.4"
            />
          </svg>
        </button>
        <p
          class="ws-status"
          role="status"
          aria-live="polite"
          tabindex="-1"
          data-signup-status
        ></p>
      </form>
    </div>
  </div>
</section>
<script>
  document
    .querySelectorAll<HTMLFormElement>("[data-wellington-signup]")
    .forEach((form) => {
      const hostname = window.location.hostname;
      const local =
        hostname !== "evander.life" &&
        hostname !== "www.evander.life" &&
        !hostname.endsWith(".netlify.app");
      const status = form.querySelector<HTMLElement>("[data-signup-status]");
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      let submitting = false;
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (local) {
          if (status) {
            status.textContent =
              "Your form is complete. This is a local preview, so nothing has been sent and you have not been signed up.";
            status.focus();
          }
          return;
        }
        if (submitting || !form.reportValidity()) return;
        submitting = true;
        const originalLabel = submit?.innerHTML;
        if (submit) {
          submit.disabled = true;
          submit.textContent = "Signing up…";
        }
        form.setAttribute("aria-busy", "true");
        if (status) status.textContent = "Submitting your signup…";
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), 20000);
        try {
          const body = new URLSearchParams();
          new FormData(form).forEach((value, key) => {
            if (typeof value === "string") body.append(key, value);
          });
          const response = await fetch("/", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: body.toString(),
            signal: controller.signal,
          });
          if (!response.ok) throw new Error("Signup failed");
          window.location.assign(form.action);
        } catch {
          submitting = false;
          form.removeAttribute("aria-busy");
          if (submit) {
            submit.disabled = false;
            if (originalLabel) submit.innerHTML = originalLabel;
          }
          if (status) {
            status.textContent =
              "We couldn’t confirm your signup. Please try again. Your details are still here.";
            status.focus();
          }
        } finally {
          window.clearTimeout(timeout);
        }
      });
    });
</script>
<style>
  .ws-signup {
    background:#edf2e5;
    color:#293126;
    padding-block:72px;
    scroll-margin-top:100px;
  }
  .ws-signup * { box-sizing:border-box; }
  .ws-layout {
    display:grid;
    grid-template-columns:minmax(0,1fr) minmax(0,1fr);
    gap:9%;
    align-items:center;
    max-width:1120px;
  }
  .ws-message h2 {
    margin:0;
    font-size:clamp(34px,3.5vw,48px);
    line-height:1.1;
    letter-spacing:-.045em;
  }
  .ws-message>p {
    max-width:340px;
    margin:20px 0 0;
    font-size:16px;
    line-height:1.6;
    color:#526448;
  }
  .ws-card {
    min-width:0;
    padding:24px;
    border:1px solid #c5d1b8;
    border-radius:10px;
    background:#f7f8f2;
    color:#293126;
  }
  .ws-card form {
    display:grid;
    gap:16px;
    scroll-margin-top:calc(var(--navh) + 24px);
  }
  .ws-card label:not(.ws-consent) {
    display:block;
    font-size:14px;
    line-height:1.4;
  }
  .ws-card input[type="email"] {
    display:block;
    width:100%;
    min-width:0;
    min-height:50px;
    margin-top:8px;
    padding:12px 14px;
    border:1px solid #a5b398;
    border-radius:6px;
    background:#fff;
    color:#293126;
    font:400 16px/1.5 var(--sans);
  }
  .ws-card input[type="email"]::placeholder { color:#737c6d; }
  .ws-card .ws-consent {
    display:flex;
    align-items:center;
    gap:10px;
    min-height:44px;
    cursor:pointer;
    font-size:13px;
    line-height:1.5;
    color:#526448;
  }
  .ws-consent input {
    width:18px;
    height:18px;
    flex:none;
    margin:0;
    accent-color:#293f34;
    cursor:pointer;
  }
  .ws-card button {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    min-height:48px;
    width:100%;
    padding:12px 16px;
    border:1px solid #293f34;
    border-radius:6px;
    background:#293f34;
    color:#fff;
    font:400 14px/1.4 var(--sans);
    cursor:pointer;
  }
  .ws-card button:hover { background:#3b5340; }
  .ws-card button:disabled { opacity:.7; cursor:wait; }
  .ws-privacy { margin:0; font-size:12px; line-height:1.5; color:#526448; }
  .ws-privacy a { color:inherit; text-decoration:underline; text-underline-offset:3px; }
  .ws-card :is(input,button,a):focus-visible,.ws-status:focus-visible {
    outline:2px solid #526448;
    outline-offset:3px;
  }
  .ws-status { margin:0; font-size:13px; line-height:1.6; color:#34472c; }
  .ws-status:empty,.ws-card .ws-honeypot { display:none; }
  @media(max-width:700px) {
    .ws-signup { padding-block:44px; }
    .ws-layout { grid-template-columns:1fr; gap:28px; }
    .ws-message>p { margin-top:16px; }
  }

  .ws-signup--compass{background:#061323;color:#f7f8f2;padding-block:80px;font-family:var(--sans)}
  .ws-signup--compass .ws-layout{max-width:1880px;width:calc(100% - 80px);grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:9%;align-items:start}
  .ws-signup--compass .ws-message{padding-top:8px}
  .ws-signup--compass .ws-message h2{font-size:clamp(40px,4.2vw,64px);font-weight:400;line-height:1.08;letter-spacing:-.045em}
  .ws-signup--compass .ws-message>p{max-width:520px;font-size:20px;line-height:1.5;color:#e0e8d9;margin-top:28px}
  .ws-benefits{display:grid;gap:22px;list-style:none;padding:0;margin:28px 0 0;max-width:540px}
  .ws-benefits li{position:relative;padding-left:27px;font-size:18px;line-height:1.55;color:#e0e8d9}
  .ws-benefits li::before{content:'✓';position:absolute;left:0;top:5px;display:grid;place-items:center;width:16px;height:16px;border:1px solid #e0e8d9;border-radius:50%;font-size:11px;line-height:1}
  .ws-benefits strong{font-weight:600;color:#fff}
  .ws-signup--compass .ws-card{background:#fff;border:0;border-radius:24px;padding:40px;color:#242722}
  .ws-signup--compass form{gap:24px}
  .ws-name-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px;min-width:0}
  .ws-signup--compass label:not(.ws-consent){font-size:13px;color:#3f493a;line-height:1.4;min-width:0}
  .ws-signup--compass label:not(.ws-consent)>span{color:#65715c;font-size:12px;font-weight:400}
  .ws-signup--compass input:not([type="checkbox"]),.ws-signup--compass select,.ws-signup--compass textarea{display:block;width:100%;min-width:0;max-width:100%;margin-top:8px;padding:15px 16px;min-height:56px;border:1px solid #a8b19f;border-radius:5px;background:#fff;color:#242722;font:400 16px/1.5 var(--sans)}
  .ws-signup--compass input::placeholder,.ws-signup--compass textarea::placeholder{color:#73796c}
  .ws-signup--compass textarea{resize:vertical;min-height:100px}
  .ws-signup--compass .ws-consent{font-size:14px;line-height:1.5;align-items:flex-start;color:#526448}
  .ws-signup--compass .ws-consent input{margin-top:2px}
  .ws-signup--compass .ws-privacy{font-size:13px}
  .ws-signup--compass button{min-height:52px;border-radius:999px;padding:14px 21px;font-size:16px}
  @media(max-width:1000px){.ws-signup--compass .ws-layout{width:calc(100% - 48px);gap:6%}.ws-signup--compass .ws-card{padding:28px}.ws-name-row{gap:14px}.ws-signup--compass .ws-message>p{font-size:18px}.ws-benefits li{font-size:16px}}
  @media(max-width:700px){.ws-signup--compass{padding-block:48px}.ws-signup--compass .ws-layout{width:calc(100% - 40px);grid-template-columns:1fr;gap:32px}.ws-signup--compass .ws-message h2{font-size:40px}.ws-signup--compass .ws-message>p{font-size:17px;margin-top:20px}.ws-signup--compass .ws-card{padding:24px 20px;border-radius:18px}.ws-signup--compass form{gap:20px}.ws-name-row{grid-template-columns:1fr;gap:20px}.ws-benefits{gap:16px;margin-top:24px}}
.ws-signup--compass .ws-card,.ws-signup--compass label:not(.ws-consent),.ws-signup--compass input:not([type="checkbox"]),.ws-signup--compass select,.ws-signup--compass textarea,.ws-signup--compass .ws-privacy,.ws-signup--compass .ws-privacy a{color:#000}.ws-signup--compass input::placeholder,.ws-signup--compass textarea::placeholder{color:#000;opacity:1}.ws-signup--compass button{background:#061323;color:#fff}.ws-signup--compass button:hover{background:#10243a}
form[data-wellington-signup]:focus{outline:none}
</style>
