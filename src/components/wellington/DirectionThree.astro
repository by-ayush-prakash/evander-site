/* A single fixed composition grounds all three explanations. */
.cp-context-art{position:relative;isolation:isolate;border-radius:24px;overflow:hidden;background:radial-gradient(ellipse at 8% 100%,#a28a3d,transparent 60%),linear-gradient(150deg,#051b10,#183a27 65%,#071a10);padding:40px;color:#f7f8f2}
.cp-context-glow{position:absolute;z-index:-1;width:120%;height:90%;top:-38%;left:10%;border:1px solid #d2b76a;border-radius:50%;transform:rotate(-28deg);background:linear-gradient(160deg,#52644066,#071b1177);box-shadow:0 3px 28px #d7be6655}.cp-context-art::after{content:"";position:absolute;z-index:-1;width:150%;height:60%;bottom:-39%;left:-30%;border:1px solid #d2b76a88;border-radius:50%;transform:rotate(-20deg);background:#05170e}
