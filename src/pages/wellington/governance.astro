@media(max-width:700px){.atlas-hero{padding-top:54px;padding-bottom:36px}.atlas-hero>p{font-size:16px;margin:22px auto}.atlas-page h1{font-size:clamp(42px,10.5vw,62px)}.atlas-section{padding-top:60px;padding-bottom:60px}.atlas-intro,.atlas-split{grid-template-columns:1fr;gap:28px}.atlas-benefits,.atlas-examples,.atlas-measures{grid-template-columns:1fr;gap:36px;margin-top:36px}.atlas-benefits article{display:grid;grid-template-columns:36px 1fr;gap:8px 18px}.atlas-benefits article>p{grid-column:2;margin-top:4px}.atlas-icon{margin:0}.atlas-benefits h3{align-self:center}.atlas-visual{padding:22px 16px;gap:18px 10px;border-radius:10px}.atlas-context{padding:10px;gap:8px;width:100%;min-width:0}.atlas-context svg{width:20px;flex-shrink:0}.atlas-context strong{font-size:12px}.atlas-context span{font-size:10px}.atlas-request{font-size:17px;padding:18px}.atlas-check{padding:18px 26px}.atlas-result{padding:18px 14px;gap:12px}.atlas-result strong{font-size:16px}.atlas-visual figcaption{font-size:11px}.atlas-example-art{height:200px}.atlas-underhood,.atlas-close{padding-block:60px}.atlas-page h3{font-size:24px}.atlas-feature-list p{padding-right:0}.atlas-map{padding:32px 16px}.atlas-map-inputs span{font-size:12px;padding:10px 8px}.atlas-examples{gap:44px}.atlas-technical-list h3{font-size:22px}}
