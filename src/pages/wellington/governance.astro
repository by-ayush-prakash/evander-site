n-block:22px;padding:20px 32px;border-radius:12px;border:1px solid #c5d1b8;background:#f7f8f2;color:#293f34;position:relative}.atlas-check::before,.atlas-check::after{content:"";position:absolute;width:1px;height:23px;background:#c5d1b8;left:50%}.atlas-check::before{bottom:100%}.atlas-check::after{top:100%}.atlas-check strong{display:block;font-weight:400;font-size:34px;letter-spacing:-.045em}.atlas-check span{font-size:14px;color:#526448}.atlas-check>svg{width:50px;height:50px;fill:none;stroke:currentColor;stroke-width:1.4}.atlas-result{display:flex;align-items:center;gap:15px;width:100%;background:#edf2e5;color:#293f34;border:1px solid #d3dfc6;border-radius:10px;padding:20px 24px}.atlas-result strong,.atlas-result span{display:block}.atlas-result strong{font-size:18px;line-height:1.3;font-weight:400}.atlas-result div>span{font-size:13px;line-height:1.5;margin-top:6px}.atlas-result>span{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:#293f34;color:white;flex-shrink:0}.atlas-context{position:absolute;display:flex;align-items:center;gap:12px;border:1px solid #ffffff50;border-radius:9px;background:#233b30;padding:16px;color:#f5f3ee}.atlas-context svg{width:26px;height:26px;stroke:#d3dfc6;stroke-width:1.3;fill:none}.atlas-context span{font-size:11px;line-height:1.5;color:#d3dfc6}.atlas-context strong{display:block;font-size:14px;font-weight:400;color:#fff}.atlas-context-one{left:5%;top:28px;transform:rotate(-4deg)}.atlas-context-two{right:4%;top:50px;transform:rotate(4deg)}.atlas-visual figcaption{margin:28px 0 0;font-size:12px;line-height:1.5;color:#e1e8d9;font-style:normal;text-align:center}.atlas-section{padding-top:100px;padding-bottom:100px}.atlas-intro{display:grid;grid-template-columns:1.15fr 1fr;align-items:center;gap:10%}.atlas-intro>p{margin:0;max-width:500px}.atlas-benefits,.atlas-examples,.atlas-measures{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:44px;margin-top:56px}.atlas-icon{display:block;width:34px;height:34px;fill:none;stroke:#526448;stroke-width:1.2;margin-bottom:28px}.atlas-benefits p,.atlas-measures p{font-size:16px}.atlas-approach{background:#fff}.atlas-split{display:grid;grid-template-columns:1fr 1fr;gap:8%;align-items:center}.atlas-approach .atlas-split{margin-top:48px}.atlas-map{display:grid;justify-items:center;background:#edf2e5;border-radius:12px;padding:50px 30px;border:1px solid #d6dfcb}.atlas-map-inputs,.atlas-map-outputs{display:flex;gap:8px;width:100%;justify-content:center}.atlas-map-inputs span,.atlas-map-outputs span{border:1px solid #b5c4a8;padding:12px 10px;font-size:13px;background:#f7f8f2;border-radius:6px;text-align:center;line-height:1.4}.atlas-map-line{height:34px;width:1px;background:#8da27a}.atlas-map-core{border-radius:10px;background:#293f34;color:#fff;text-align:center;padding:26px;width:75%}.atlas-map-core span{display:block;font-size:33px;letter-spacing:-.04em}.atlas-map-core strong{display:block;font-weight:400;font-size:14px;margin-top:8px;color:#e1e8d9}.atlas-map-outputs span{flex:1}.atlas-feature-list details{padding:25px 0;border-bottom:1px solid #d6dfcb}.atlas-feature-list details:first-child{border-top:1px solid #d6dfcb}.atlas-feature-list summary{cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:44px}.atlas-feature-list summary::-webkit-details-marker{display:none}.atlas-feature-list summary>span{font-size:26px;color:#526448}.atlas-feature-list details[open] summary>span{transform:rotate(45deg)}.atlas-feature-list p{font-size:16px;padding-right:30px}.atlas-examples{gap:24px}.atlas-example-art{height:210px;background:#e7eddf;border-radius:10px;display:grid;place-items:center;padding:24px;margin-bottom:28px;overflow:hidden}.atlas-examples blockquote{margin:18px 0 0;font-size:17px;line-height:1.5;color:#293126}.atlas-examples p{font-size:15px}.atlas-examples .atlas-example-result{color:#293f34}.atlas-week{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:10px 14px;width:100%}.atlas-week span{font-size:11px;color:#526448}.atlas-week strong{font-weight:400;background:#f7f8f2;border:1px solid #b5c4a8;border-radius:6px;padding:15px;font-size:15px;display:flex;justify-content:space-between;gap:12px}.atlas-week svg,.atlas-sharing svg{width:20px;height:20px;stroke:#526448;stroke-width:1.4;fill:none}.atlas-files{display:flex;gap:30px}.atlas-files>div{display:grid;gap:12px;justify-items:center;font-size:13px;color:#526448}.atlas-files svg{height:70px;width:60px;stroke:#526448;fill:#f7f8f2;stroke-width:1}.atlas-files>div:last-child{transform:translateY(16px)}.atlas-sharing{width:100%;max-width:240px;display:grid;justify-items:center}.atlas-sharing>span{font-size:13px;border:1px dashed #8da27a;border-radius:6px;padding:12px 20px;color:#526448}.atlas-sharing>div{height:24px;width:1px;background:#8da27a}.atlas-sharing strong{display:flex;align-items:center;gap:24px;font-size:16px;font-weight:400;border-radius:6px;background:#f7f8f2;border:1px solid #b5c4a8;padding:16px}.atlas-underhood{padding-block:90px;background:#293f34;color:#f5f3ee}.atlas-underhood h2 span{color:#b5c4a8}.atlas-underhood p{color:#e1e8d9;font-size:16px}.atlas-technical-list article+article{border-top:1px solid #697d67;margin-top:24px;padding-top:24px}.atlas-technical-list h3{font-size:22px}.atlas-link{display:inline-flex;align-items:center;gap:28px;min-height:44px;color:inherit;margin-top:28px;text-decoration:underline;text-underline-offset:6px;font-size:15px}.atlas-close{text-align:center;background:#edf2e5;padding-block:90px}.atlas-close p{max-width:540px;margin:24px auto}.atlas-page :global([id]){scroll-margin-top:100px}.atlas-page :global(a:focus-visible),.atlas-feature-list summary:focus-visible{outline:2px solid #b7242b;outline-offset:5px}
