---
import Base from "../../layouts/Base.astro";
---

<Base
  title="Wellington | Thank you"
  description="You’re signed up for Wellington access updates and availability."
  noindex={true}
  cta={false}
>
  <section class="wrap" style="padding-block:100px;min-height:55vh">
    <h1 style="font-size:clamp(42px,6vw,76px)">
      You’re on the list.
    </h1>
    <p style="font-size:18px;line-height:1.7;margin-top:30px;max-width:580px">
      We’ll email you with Wellington access updates and availability.
    </p>
    <a class="btn" href="/wellington/" style="margin-top:30px">
      Return to Wellington
    </a>
  </section>
</Base>
