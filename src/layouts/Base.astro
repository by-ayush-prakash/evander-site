---
import "../styles/global.css";
import SiteFonts from "../components/SiteFonts.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { ORG } from "../config";

const {
  title,
  description = "The Center for Innovating the Future is a venture builder and research platform exploring the forces reshaping human life through research, publishing, conversations, convenings, and briefings.",
  noindex = false,
  socialTitle,
  socialImage = "/cif-wordmark-share-v1.png",
  socialImageAlt = "Center for Innovating the Future logo",
  socialCard = socialImage === "/favicon-512.png" ? "summary" : "summary_large_image",
  socialImageWidth = socialImage === "/cif-wordmark-share-v1.png" ? 1200 : socialImage === "/favicon-512.png" ? 512 : socialImage === "/og-v2.png" ? 2400 : undefined,
  socialImageHeight = socialImage === "/cif-wordmark-share-v1.png" ? 630 : socialImage === "/favicon-512.png" ? 512 : socialImage === "/og-v2.png" ? 1260 : undefined,
  // Closing CTA, passed straight through to the footer.
  cta = true,
  ctaHeading,
  ctaLabel,
  ctaHref,
  ctaField,
  ctaLinks,
} = Astro.props;

const full = Astro.url.pathname === "/" ? "Evander" : `${ORG.short} | ${title ?? "Home"}`;
const social = socialTitle ?? (title ? `${title}, ${ORG.name}` : ORG.name);  // shares and search cards
const path = Astro.url.pathname === "/" ? "/" : `${Astro.url.pathname.replace(/\/+$/, "")}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={social} />
    <meta property="og:site_name" content={ORG.name} />
    <meta name="twitter:card" content={socialCard} />
    <meta name="twitter:title" content={social} />
    <meta name="twitter:description" content={description} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="describedby" href="https://innovatingfuture.com/llms.txt" type="text/plain" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta property="og:image" content={new URL(socialImage, Astro.site)} />
    {socialImageWidth && <meta property="og:image:width" content={String(socialImageWidth)} />}
    {socialImageHeight && <meta property="og:image:height" content={String(socialImageHeight)} />}
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:image" content={new URL(socialImage, Astro.site)} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/png" sizes="32x32" href="/images/cif-assembly-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=9" />
    <meta name="theme-color" content="#FFFFFF" />
    <SiteFonts />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav path={path} />
    <main id="main"><slot /></main>
    <slot name="overlay" />
    <Footer cta={cta} ctaHeading={ctaHeading} ctaLabel={ctaLabel} ctaHref={ctaHref} ctaField={ctaField} ctaLinks={ctaLinks} />
    <script is:inline>
        (() => {
          const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const selectors = [
            '.hero h1', '.hero .lede', '.hero .cta', '.hcards > *',
            '.ph-sec h1', '.ph-sec .lede', '.ph-sec .cta', '.ph-split > *',
            '.sec .wrap > *', '.band .wrap > *', '.ctab .wrap > *',
            '.fgrid > *'
          ];
          const items = [...new Set(selectors.flatMap((selector) => [...document.querySelectorAll(selector)]))];

          items.forEach((item) => {
            const media = item.matches('.card, .ncard, .bleed, .afig, .cov, .person, .hcards > *');
            item.setAttribute('data-motion-reveal', media ? 'media' : 'content');
            const siblings = item.parentElement ? [...item.parentElement.children] : [];
            const siblingIndex = Math.max(0, siblings.indexOf(item));
            item.style.setProperty('--motion-delay', `${Math.min(siblingIndex, 4) * 70}ms`);
          });

          document.documentElement.classList.add('motion-ready');
          if (reduced || !('IntersectionObserver' in window)) {
            items.forEach((item) => item.classList.add('is-visible'));
            return;
          }

          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          // Long transcript containers can never expose 8% in one viewport.
          // Reveal as soon as any part enters the usable viewport.
          }, { threshold: 0, rootMargin: '0px 0px -8% 0px' });

          addEventListener('pagehide', () => {
            observer.disconnect();
            items.forEach(item => item.classList.add('is-visible'));
          }, {once:true});
          addEventListener('pageshow', event => {
            if (event.persisted) items.forEach(item => item.classList.add('is-visible'));
          });
          requestAnimationFrame(() => items.forEach((item) => observer.observe(item)));
        })();
      </script>
  </body>
</html>
